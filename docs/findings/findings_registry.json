{
  "about": "Machine-readable provenance for the written findings in docs/findings/*.md. Each claim lists the metric values that corroborate it (as <results file>:<dot.path>), the procedure, the data sources and the code that produced it. tests/test_findings_registry.py checks every listed value against the results files, so prose and numbers cannot drift apart silently.",
  "conventions": {
    "metric_ref": "<file under results/>:<dot.separated.path>; keyed dicts (e.g. by_combination.<model>|<condition>) rather than list indices",
    "unit": "Majority label per fragment x model x prompt condition unless stated; corrected (accuracy-only) scoring; locked gold 2026-10-03 unless stated",
    "status": "agreed = wording agreed with the author; draft = discussed, wording open"
  },
  "sources": {
    "scored_db_corrected": {
      "path": "data/responses/scored_database_corrected.csv",
      "description": "5,400 runs, corrected (accuracy-only) scoring"
    },
    "fragment_outcomes_corrected": {
      "path": "data/responses/fragment_outcomes_corrected.csv",
      "description": "1,800 fragment x model x condition outcomes, majority rule"
    },
    "fragment_outcomes_triangulated": {
      "path": "data/responses/fragment_outcomes_triangulated.csv",
      "description": "As corrected, with 35 contested labels replaced by the third reviewer's"
    },
    "gold_locked": {
      "path": "data/gold_standard/gold_standard_locked_2026-10-03.csv",
      "description": "Locked expert gold standard (150 fragments)"
    },
    "gold_supplement": {
      "path": "data/gold_standard/gold_standard_rationale_supplement.csv",
      "description": "18 pre-lock rating revisions with original ratings"
    },
    "contested_review": {
      "path": "data/responses/contested_fragments_review_resolved.csv",
      "description": "35 contested fragments with the independent third reviewer's blind classification"
    },
    "rc2_retest": {
      "path": "reliability/blind_retest_40frag_pass2.csv",
      "description": "RC2: two human raters and the anchor (original and pass-2) on 40 fragments"
    },
    "rc1": {
      "path": "reliability/rc1_expert_temporal_consistency.csv",
      "description": "RC1: anchor blind test-retest on 20 fragments"
    },
    "gpt_coding": {
      "path": "data/analysis/failure_codes_gpt5.csv",
      "description": "Completed GPT failure-coding sheet (76 fragments, 112 rows)"
    },
    "rc3_review": {
      "path": "logs/human_review_key.csv",
      "description": "RC3: stratified human review of coherence-flagged runs (with logs/human_review_blinded.csv)"
    },
    "rc3_blinded": {
      "path": "logs/human_review_blinded.csv",
      "description": "RC3: blinded rationales with the author's coherence ratings"
    },
    "luna_triage": {
      "path": "data/responses/triangulation_luna_ambiguous.csv",
      "description": "Secondary-model (gpt-5.6-luna) triage of all 1,217 ambiguous runs"
    },
    "fragment_outcomes_as_designed": {
      "path": "data/responses/fragment_outcomes.csv",
      "description": "Fragment outcomes under the pre-registered scoring (coherence gate)"
    },
    "scored_db_as_designed": {
      "path": "data/responses/scored_database.csv",
      "description": "5,400 runs under the pre-registered scoring, with coherence_final"
    }
  },
  "findings": [
    {
      "id": "RQ1",
      "research_question": "To what extent can large language models accurately assess the quality of evaluative reasoning?",
      "status": "agreed",
      "document": "docs/findings/rq1.md",
      "headline": "LLMs agreed with the expert 60% of the time, barely better than a coin flip but about as often as trained human evaluators did, and they erred toward leniency.",
      "claims": [
        {
          "id": "RQ1.a",
          "text": "LLMs agreed with the expert on ~60% of fragments (95% CI 54-66%).",
          "values": [
            {
              "metric": "findings_metrics.json:pass_rate.corrected.pass_rate_pct",
              "value": 59.9
            },
            {
              "metric": "findings_metrics.json:pass_rate.corrected.ci_95_pct",
              "value": [
                54.3,
                65.5
              ]
            },
            {
              "metric": "findings_metrics.json:pass_rate.run_level_corrected.pct",
              "value": 59.6
            }
          ],
          "procedure": "Pooled fragment-level pass rate across 6 models x 2 conditions x 150 fragments; 95% CI by fragment-clustered bootstrap (5,000 resamples, seed 42).",
          "sources": [
            "fragment_outcomes_corrected",
            "scored_db_corrected"
          ],
          "code": "src/analysis/findings_metrics.py:cluster_bootstrap_pass_rate"
        },
        {
