# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Environment and secrets
.env
*.key
api_keys.yaml

# Data files (tracked selectively)
data/responses/*
data/raw/*
!data/raw/.gitkeep
!data/responses/.gitkeep
# The real 5,400-call run and its scoring outputs -- small (<5MB each),
# expensive/slow to regenerate (response_database.csv alone represents
# ~$99 and several days of real API calls), and otherwise unbacked-up.
# data/responses/pilot/ stays ignored -- not part of the official run.
!data/responses/response_database.csv
!data/responses/scored_database.csv
!data/responses/fragment_outcomes.csv
!data/responses/performance_matrix.csv
!data/responses/gpt_5_6_sol_failures_for_coding.csv
# RC2-corrected (accuracy-only) scoring outputs and the Luna triage that
# informed RC2's stratified sample -- the triage cost real API calls.
!data/responses/scored_database_corrected.csv
!data/responses/fragment_outcomes_corrected.csv
!data/responses/performance_matrix_corrected.csv
!data/responses/gpt_5_6_sol_failures_for_coding_corrected.csv
!data/responses/triangulation_luna_ambiguous.csv
# Human-rater data (de-identified) and analyses built on it: the failure
# coding worksheet and the external-reviewer secondary analysis of the 35
# contested fragments. Irreplaceable human judgment -- tracked for backup
# and reproducibility.
!data/responses/gpt_5_6_sol_failure_coding_worksheet.csv
!data/responses/contested_fragments_model_vs_anchor.csv
!data/responses/contested_fragments_review_resolved.csv
!data/responses/scored_database_triangulated.csv
!data/responses/fragment_outcomes_triangulated.csv

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
logs/*
!logs/.gitkeep
# Run provenance for the official 5,400-call execution.
!logs/benchmark_session_log.jsonl
!logs/execution_order_log.csv
!logs/failed_calls.jsonl
!logs/corpus_token_audit.csv
!logs/calibration_token_audit.csv
# RC2 blind human review and the contested-fragment external review packet,
# returned ratings (original .numbers + CSV conversion), and blinding keys.
!logs/human_review_blinded.csv
!logs/human_review_key.csv
!logs/contested_fragments_review_blinded.csv
!logs/contested_fragments_review_blinded_2.numbers
!logs/contested_fragments_review_returned.csv
!logs/contested_fragments_review_key.csv
!logs/contested_fragments_review_instructions.md

